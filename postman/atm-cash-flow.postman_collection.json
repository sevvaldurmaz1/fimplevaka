{
  "info": {
    "name": "Fimple ATM Cash Management - End-to-end",
    "description": "Complete assignment scenario: setup, quote/confirm, deposit, maintenance, reconciliation, different-user approval, consistency and reporting. Extra checks exercise idempotent confirmation and cancellation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "atmId",
      "value": ""
    },
    {
      "key": "quoteId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    },
    {
      "key": "confirmationResult",
      "value": ""
    },
    {
      "key": "reconciliationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Create ATM",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/atms",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Fimple Demo ATM\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful status\", () => pm.expect(pm.response.code).to.eql(201));",
              "pm.collectionVariables.set(\"atmId\", pm.response.json().id);",
              "pm.test(\"Expected state\", () => pm.expect(pm.response.json().state).to.eql(\"UNCONFIGURED\"));",
              "pm.collectionVariables.set(\"idempotencyKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Configure cassettes",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/atms/{{atmId}}/configuration",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cassettes\": [\n    {\n      \"number\": 1,\n      \"currency\": \"TRY\",\n      \"denomination\": 100\n    },\n    {\n      \"number\": 2,\n      \"currency\": \"TRY\",\n      \"denomination\": 50\n    },\n    {\n      \"number\": 3,\n      \"currency\": \"TRY\",\n      \"denomination\": 20\n    },\n    {\n      \"number\": 4,\n      \"currency\": \"USD\",\n      \"denomination\": 100\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful status\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test(\"Expected state\", () => pm.expect(pm.response.json().state).to.eql(\"CONFIGURED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Load cash",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/atms/{{atmId}}/loads",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": [\n    {\n      \"cassetteNumber\": 1,\n      \"currency\": \"TRY\",\n      \"denomination\": 100,\n      \"count\": 98\n    },\n    {\n      \"cassetteNumber\": 2,\n      \"currency\": \"TRY\",\n      \"denomination\": 50,\n      \"count\": 20\n    },\n    {\n      \"cassetteNumber\": 3,\n      \"currency\": \"TRY\",\n      \"denomination\": 20,\n      \"count\": 30\n    },\n    {\n      \"cassetteNumber\": 4,\n      \"currency\": \"USD\",\n      \"denomination\": 100,\n      \"count\": 5\n    },\n    {\n      \"cassetteNumber\": 5,\n      \"currency\": \"EUR\",\n      \"denomination\": 20,\n      \"count\": 99\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful status\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test(\"Expected state\", () => pm.expect(pm.response.json().state).to.eql(\"LOADED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Put in service",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/atms/{{atmId}}/state",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"state\": \"IN_SERVICE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful status\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test(\"Expected state\", () => pm.expect(pm.response.json().state).to.eql(\"IN_SERVICE\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Quote 160 TRY",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/atms/{{atmId}}/withdrawals/quotes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cardNumber\": \"4000000000000001\",\n  \"currency\": \"TRY\",\n  \"amount\": 160\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful status\", () => pm.expect(pm.response.code).to.eql(201));",
              "pm.collectionVariables.set(\"quoteId\", pm.response.json().id);",
              "pm.test(\"Exact offer\", () => pm.expect(pm.response.json().options[0].amount).to.eql(160));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Confirm quote",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/atms/{{atmId}}/withdrawals/quotes/{{quoteId}}/confirm",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 160\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful status\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.collectionVariables.set(\"confirmationResult\", pm.response.text());",
              "pm.test(\"Confirmed amount\", () => pm.expect(pm.response.json().amount).to.eql(160));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Repeat same confirmation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/atms/{{atmId}}/withdrawals/quotes/{{quoteId}}/confirm",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 160\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful status\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test(\"Identical persisted result\", () => pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get(\"confirmationResult\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Read inventory",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/atms/{{atmId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful status\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test(\"Only four notes debited\", () => pm.expect(pm.response.json().cassettes.reduce((sum, c) => sum + c.noteCount, 0)).to.eql(248));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Deposit overflow and return notes",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/atms/{{atmId}}/deposits",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": [\n    {\n      \"currency\": \"TRY\",\n      \"denomination\": 100,\n      \"count\": 6\n    },\n    {\n      \"currency\": \"EUR\",\n      \"denomination\": 50,\n      \"count\": 1\n    }\n  ],\n  \"unrecognizedCount\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful status\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test(\"Four notes accepted\", () => pm.expect(pm.response.json().acceptedNoteCount).to.eql(4));",
              "pm.test(\"Three recognized notes returned\", () => pm.expect(pm.response.json().returnedRecognizedNoteCount).to.eql(3));",
              "pm.test(\"Two unrecognized notes returned\", () => pm.expect(pm.response.json().unrecognizedReturnedCount).to.eql(2));",
              "pm.test(\"Accepted TRY total\", () => pm.expect(pm.response.json().acceptedTotals.TRY).to.eql(400));",
              "pm.test(\"Recycling then deposit\", () => pm.expect(pm.response.json().accepted.map(note => note.cassetteNumber)).to.eql([1, 5]));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Read inventory after deposit",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/atms/{{atmId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful status\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test(\"Only accepted notes credited\", () => pm.expect(pm.response.json().cassettes.reduce((sum, c) => sum + c.noteCount, 0)).to.eql(252));",
              "pm.test(\"No cassette exceeds capacity\", () => pm.response.json().cassettes.forEach(c => pm.expect(c.noteCount).to.be.at.most(c.capacity)));"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Quote 20 TRY",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/atms/{{atmId}}/withdrawals/quotes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cardNumber\": \"4000000000000001\",\n  \"currency\": \"TRY\",\n  \"amount\": 20\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful status\", () => pm.expect(pm.response.code).to.eql(201));",
              "pm.collectionVariables.set(\"quoteId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Cancel quote",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/atms/{{atmId}}/withdrawals/quotes/{{quoteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful status\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test(\"Cancelled\", () => pm.expect(pm.response.json().status).to.eql(\"CANCELLED\"));",
              "pm.test(\"No amount remains reserved\", () => pm.expect(pm.response.json().reservedAmount).to.eql(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Repeat cancellation",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/atms/{{atmId}}/withdrawals/quotes/{{quoteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful status\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test(\"Still cancelled\", () => pm.expect(pm.response.json().status).to.eql(\"CANCELLED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "14. Switch to maintenance",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/atms/{{atmId}}/state",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"state\": \"MAINTENANCE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful status\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test(\"Maintenance\", () => pm.expect(pm.response.json().state).to.eql(\"MAINTENANCE\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "15. Reconcile physical counts",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-User",
            "value": "counter"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/atms/{{atmId}}/reconciliations",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cassettes\": [\n    {\n      \"number\": 1,\n      \"notes\": [\n        {\n          \"currency\": \"TRY\",\n          \"denomination\": 100,\n          \"count\": 100\n        }\n      ]\n    },\n    {\n      \"number\": 2,\n      \"notes\": [\n        {\n          \"currency\": \"TRY\",\n          \"denomination\": 50,\n          \"count\": 20\n        }\n      ]\n    },\n    {\n      \"number\": 3,\n      \"notes\": [\n        {\n          \"currency\": \"TRY\",\n          \"denomination\": 20,\n          \"count\": 27\n        }\n      ]\n    },\n    {\n      \"number\": 4,\n      \"notes\": [\n        {\n          \"currency\": \"USD\",\n          \"denomination\": 100,\n          \"count\": 4\n        }\n      ]\n    },\n    {\n      \"number\": 5,\n      \"notes\": [\n        {\n          \"currency\": \"EUR\",\n          \"denomination\": 20,\n          \"count\": 99\n        },\n        {\n          \"currency\": \"TRY\",\n          \"denomination\": 100,\n          \"count\": 1\n        }\n      ]\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.expect(pm.response.code).to.eql(201));",
              "pm.collectionVariables.set(\"reconciliationId\", pm.response.json().id);",
              "pm.test(\"Awaiting different user\", () => pm.expect(pm.response.json().status).to.eql(\"AWAITING_APPROVAL\"));",
              "pm.test(\"Foreign difference TRY value\", () => pm.expect(pm.response.json().totalDifferenceTry).to.eql(3500));"
            ]
          }
        }
      ]
    },
    {
      "name": "16. Service blocked while awaiting approval",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/atms/{{atmId}}/state",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"state\": \"IN_SERVICE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.expect(pm.response.code).to.eql(409));",
              "pm.test(\"Approval required\", () => pm.expect(pm.response.json().code).to.eql(\"reconciliation_awaiting_approval\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "17. Same user cannot approve",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-User",
            "value": "COUNTER"
          }
        ],
        "url": "{{baseUrl}}/api/atms/{{atmId}}/reconciliations/{{reconciliationId}}/approve"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.expect(pm.response.code).to.eql(409));",
              "pm.test(\"Four-eyes rule\", () => pm.expect(pm.response.json().code).to.eql(\"same_user_approval\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "18. Different user approves",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-User",
            "value": "approver"
          }
        ],
        "url": "{{baseUrl}}/api/atms/{{atmId}}/reconciliations/{{reconciliationId}}/approve"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test(\"Applied\", () => pm.expect(pm.response.json().status).to.eql(\"APPLIED\"));",
              "pm.test(\"Approver recorded\", () => pm.expect(pm.response.json().approvedBy).to.eql(\"approver\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "19. Check movement consistency",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/atms/{{atmId}}/consistency"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test(\"Ledger matches inventory\", () => pm.expect(pm.response.json().isConsistent).to.eql(true));",
              "pm.test(\"No differences\", () => pm.expect(pm.response.json().differences).to.eql([]));"
            ]
          }
        }
      ]
    },
    {
      "name": "20. Operations report",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/atms/{{atmId}}/report"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test(\"TRY total\", () => pm.expect(pm.response.json().totalInTry).to.eql(104840));",
              "pm.test(\"No pending approval\", () => pm.expect(pm.response.json().pendingReconciliationId).to.eql(null));",
              "pm.test(\"Physical note count\", () => pm.expect(pm.response.json().cassettes.reduce((sum, cassette) => sum + cassette.noteCount, 0)).to.eql(251));"
            ]
          }
        }
      ]
    },
    {
      "name": "21. Return to service",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/atms/{{atmId}}/state",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"state\": \"IN_SERVICE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test(\"Back in service\", () => pm.expect(pm.response.json().state).to.eql(\"IN_SERVICE\"));"
            ]
          }
        }
      ]
    }
  ]
}
